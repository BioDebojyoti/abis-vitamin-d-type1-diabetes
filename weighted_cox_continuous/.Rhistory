adjusted_weighted_cox_sTfR_logFerritin <- coxph(
Surv(exit_age, event = event) ~ sTfR_logFerritin + T1D_heredity_cat +
Iron_tablet_or_supplement_during_pregnancy + Smoking_during_pregnancy +
Parity +  Delivery_mode + Preterm_dichotomous + Birth_weight + Sex_cat,
data = df_cox_full,
weights = if_else(event == 1, 1, 1 / f),
robust = TRUE,
cluster = ABISnr
)
child_levels <- paste0(
paste0(unlist(lapply(c(child_covariates[-2], "Birth_weight_cat", "Ferritin", "TfR", "sTfR_logFerritin"), function(x)
levels(factor(df_cox_full[[x]]))))[-2], collapse = "|"), "|^Preterm$")
child_pat_replace <- paste0(c(child_covariates[-2],"Birth_weight_cat"),collapse = "|")
maternal_levels <- paste0(
unique(
unlist(
lapply(
c(maternal_covariates, "Ferritin", "TfR", "sTfR_logFerritin"),
function(x) levels(factor(df_cox_full[[x]]))
)
)
),
collapse = "|")
maternal_pat_replace <- paste0(maternal_covariates, collapse = "|")
all_levels <- (paste0(paste0(
unique(
unlist(
lapply(
c(child_covariates[-2],"Birth_weight_cat",maternal_covariates, "Ferritin", "TfR","sTfR_logFerritin"),
function(x) levels(factor(df_cox_full[[x]]))
)
)
)[-2],
collapse = "|"), "|^Preterm$"))
all_pat_replace <- paste0(
c(child_covariates[-2],"Birth_weight_cat",maternal_covariates), collapse = "|")
tidy_unadjusted_weighted_cox_ferritin <- tidy_base_model(
unadjusted_weighted_cox_ferritin,
"Unadjusted",
"Ferritin",
df_cox_full = df_cox_full
)
tidy_unadjusted_weighted_cox_tfr <- tidy_base_model(
unadjusted_weighted_cox_tfr,
"Unadjusted",
"TfR",
df_cox_full = df_cox_full
)
tidy_unadjusted_weighted_cox_sTfR_logFerritin <- tidy_base_model(
unadjusted_weighted_cox_sTfR_logFerritin,
"Unadjusted",
"sTfR_logFerritin",
df_cox_full = df_cox_full
)
tidy_adjusted_weighted_cox_ferritin <- tidy_model_specific_covariates(
model = adjusted_weighted_cox_ferritin,
predictor = "Ferritin",
model_name = "Adjusted",
covariates_as_pattern = all_pat_replace,
covariate_levels_as_pattern = all_levels,
df_cox_full = df_cox_full
)
tidy_adjusted_weighted_cox_tfr <- tidy_model_specific_covariates(
model = adjusted_weighted_cox_tfr,
predictor = "TfR",
model_name = "Adjusted",
covariates_as_pattern = all_pat_replace,
covariate_levels_as_pattern = all_levels,
df_cox_full = df_cox_full
)
tidy_adjusted_weighted_cox_sTfR_logFerritin <- tidy_model_specific_covariates(
model = adjusted_weighted_cox_sTfR_logFerritin,
predictor = "sTfR_logFerritin",
model_name = "Adjusted",
covariates_as_pattern = all_pat_replace,
covariate_levels_as_pattern = all_levels,
df_cox_full = df_cox_full
)
merged_all_weighted_cox_results <-  rbind(
tidy_unadjusted_weighted_cox_ferritin,
tidy_unadjusted_weighted_cox_tfr,
tidy_unadjusted_weighted_cox_sTfR_logFerritin,
tidy_adjusted_weighted_cox_ferritin,
tidy_adjusted_weighted_cox_tfr,
tidy_adjusted_weighted_cox_sTfR_logFerritin
) %>%
dplyr::mutate(
Term = case_when(
grepl("sTfR",Term) ~ "sTfR/log10(Ferritin)",
"TfR" == Term ~ "sTfR",
TRUE ~ Term
),
Model = if_else(row_number() != 1 &
lag(Model, 1) == Model &
!(Term %in% c(
"Ferritin", "sTfR", "sTfR/log10(Ferritin)"
)),
NA_character_,
Model)
) %>%
dplyr::mutate(
Model = if_else(row_number() != 1 &
(!is.na(lag(Model,1)) & Model == lag(Model, 1)),
NA_character_,
Model)
)
merged_all_weighted_cox_results_short_flex <- merged_all_weighted_cox_results %>%
dplyr::filter(Term %in% c("Ferritin","sTfR", "sTfR/log10(Ferritin)"))  %>%
dplyr::mutate(
Model = if_else(row_number() != 1 &
(!is.na(lag(Model,1)) & Model == lag(Model, 1)),
NA_character_,
Model)
) %>%
flextable::flextable() %>%
flextable::autofit() %>%
flextable::set_table_properties(width = 1, layout = "autofit") %>%
flextable::color(
i = ~ as.numeric(`P-value`) < 0.05,
j = c("Term", "Level", "P-value"),
color = "red"
)
merged_all_weighted_cox_results_long_flex <- merged_all_weighted_cox_results %>%
flextable::flextable() %>%
flextable::autofit() %>%
flextable::set_table_properties(width = 1, layout = "autofit") %>%
flextable::color(
i = ~ as.numeric(`P-value`) < 0.05,
j = c("Term", "Level", "P-value"),
color = "red"
)
flextable::save_as_docx(
`Weighted Cox model ` = merged_all_weighted_cox_results_short_flex,
path = paste0(output_dir,"/flex_merged_all_weighted_cox_results_short.docx"),
pr_section = sect_properties
)
flextable::save_as_docx(
`Weighted Cox model` = merged_all_weighted_cox_results_long_flex,
path = paste0(output_dir,"/flex_merged_all_weighted_cox_results_long.docx"),
pr_section = sect_properties
)
saveRDS(
object = merged_all_weighted_cox_results_short_flex,
file = paste0(
output_dir,
"/flex_merged_all_weighted_cox_results_short.RDS"
)
)
saveRDS(
object = merged_all_weighted_cox_results_long_flex,
file = paste0(
output_dir,
"/flex_merged_all_weighted_cox_results_long.RDS"
)
)
rm(list = ls())
gc()
