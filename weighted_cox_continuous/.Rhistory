library(dplyr)
iqr_table <- function(df, df_name){
iqr_table <- df %>%
summarise(
Cohort = df_name,
Ferritin_Q1 = quantile(Ferritin, 0.25, na.rm = TRUE),
Ferritin_Median = median(Ferritin, na.rm = TRUE),
Ferritin_Q3 = quantile(Ferritin, 0.75, na.rm = TRUE),
sTfR_Q1 = quantile(TfR, 0.25, na.rm = TRUE),
sTfR_Median = median(TfR, na.rm = TRUE),
sTfR_Q3 = quantile(TfR, 0.75, na.rm = TRUE),
TfR_F_Q1 = quantile(sTfR_logFerritin, 0.25, na.rm = TRUE),
TfR_F_Median = median(sTfR_logFerritin, na.rm = TRUE),
TfR_F_Q3 = quantile(sTfR_logFerritin, 0.75, na.rm = TRUE)
)
return(iqr_table)
}
