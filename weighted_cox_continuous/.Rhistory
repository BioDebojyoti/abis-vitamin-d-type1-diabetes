library(haven)
library(readxl)
library(dplyr)
library(tidyr)
abis_variables <-  readRDS("/Users/debda22/Projects/abis-data/variable_description.RDS")
abis <- haven::read_sav("/Users/debda22/Projects/abis-data/Updated registries/ABIS_Database_Updated_240124.sav")
data.delivery.info.file <- "/Users/debda22/Projects/initialise-data-delivery/ABIS sample deliveries_updated 2026-03-11.xlsx"
excel_sheets(data.delivery.info.file)
# [1] "Deliveries summary"            "Sample IDs all deliveries A-Z"
#-----------------------------------------------------------------------------------------
# collect sample numbers
#-----------------------------------------------------------------------------------------
sample.IDs.df <- read_xlsx(data.delivery.info.file, sheet = "Sample IDs all deliveries A-Z")
#-----------------------------------------------------------------------------------------
# collect column names
#-----------------------------------------------------------------------------------------
delivery.summary.df.original <- read_xlsx(data.delivery.info.file, sheet = "Deliveries summary")
delivery.summary.df <- delivery.summary.df.original %>%
dplyr::filter(grepl("ABIS, INITIALISE", `Study / Project`, ignore.case = TRUE)) %>%
dplyr::arrange(Analysis)
#
delivery.columns <- delivery.summary.df.original %>%
dplyr::filter(
(grepl("Serum", `Sample type`)) & grepl("Birth|^5 year",`Prov ålder`, ignore.case = TRUE) & grepl("Inflammatory|Metabolomics",Analysis, ignore.case = TRUE)
) %>%
dplyr::filter(!(grepl("Metabolomics",Analysis, ignore.case = TRUE) & is.na(Diagnoses)))
#-----------------------------------------------------------------------------------------
# cord blood OLINK, total n=1199+609 =1808?
#-----------------------------------------------------------------------------------------
cord.blood.OLINK.column.names <- delivery.columns %>%
dplyr::filter(grepl("Birth", `Prov ålder`) & grepl("Inflammatory panel", Analysis)) %>%
dplyr::pull(`Delivery codename (PI_project_sample_number_date)`)
cord.blood.OLINK.samples <- sample.IDs.df %>%
dplyr::select(all_of(cord.blood.OLINK.column.names)) %>%
tidyr::pivot_longer(everything(), values_to = "ABISnr", names_to = "PI_project_sample_number_date") %>%
dplyr::filter(!is.na(ABISnr)) %>%
as.data.frame() %>%
dplyr::pull(ABISnr)
#-----------------------------------------------------------------------------------------
# cord blood metabolomics, total n=1085
#-----------------------------------------------------------------------------------------
cord.blood.Metabolomics.column.names <- delivery.columns %>%
dplyr::filter(grepl("Birth", `Prov ålder`) & grepl("Metabolomics", Analysis)) %>%
dplyr::pull(`Delivery codename (PI_project_sample_number_date)`)
cord.blood.Metabolomics.samples <- sample.IDs.df %>%
dplyr::select(all_of(cord.blood.Metabolomics.column.names)) %>%
tidyr::pivot_longer(everything(), values_to = "ABISnr", names_to = "PI_project_sample_number_date") %>%
dplyr::filter(!is.na(ABISnr)) %>%
as.data.frame() %>%
dplyr::pull(ABISnr)
#-----------------------------------------------------------------------------------------
# 5-year OLINK, total n=650
#-----------------------------------------------------------------------------------------
five.year.OLINK.column.names <- delivery.columns %>%
dplyr::filter(grepl("5 year", `Prov ålder`) & grepl("Inflammatory panel", Analysis)) %>%
dplyr::pull(`Delivery codename (PI_project_sample_number_date)`)
five.year.OLINK.samples <- sample.IDs.df %>%
dplyr::select(all_of(five.year.OLINK.column.names)) %>%
tidyr::pivot_longer(everything(), values_to = "ABISnr", names_to = "PI_project_sample_number_date") %>%
dplyr::filter(!is.na(ABISnr)) %>%
as.data.frame() %>%
dplyr::pull(ABISnr)
#-----------------------------------------------------------------------------------------
# 5-year metabolomics, total n=651
#-----------------------------------------------------------------------------------------
five.year.Metabolomics.column.names <- delivery.columns %>%
dplyr::filter(grepl("5 year", `Prov ålder`) & grepl("Metabolomics", Analysis)) %>%
dplyr::pull(`Delivery codename (PI_project_sample_number_date)`)
five.year.Metabolomics.samples <- sample.IDs.df %>%
dplyr::select(all_of(five.year.Metabolomics.column.names)) %>%
tidyr::pivot_longer(everything(), values_to = "ABISnr", names_to = "PI_project_sample_number_date") %>%
dplyr::filter(!is.na(ABISnr)) %>%
as.data.frame() %>%
dplyr::pull(ABISnr)
cord.blood.OLINK.column.names
five.year.OLINK.column.names
five.year.OLINK.samples
