complete_df <- readRDS("/Users/debda22/Projects/abis-ferritin-type1-diabetes/results/revision/weighted_cox/full_cox_data.RDS")
zero2five_df <- readRDS("/Users/debda22/Projects/abis-ferritin-type1-diabetes/results/revision/weighted_cox/zero_to_five_year_cox_data.RDS")
five2ten_df <- readRDS("/Users/debda22/Projects/abis-ferritin-type1-diabetes/results/revision/weighted_cox/five_to_ten_year_cox_data.RDS")
ten2fifteen_df <- readRDS("/Users/debda22/Projects/abis-ferritin-type1-diabetes/results/revision/weighted_cox/ten_to_fifteen_year_cox_data.RDS")
fifteen2followupend_df <- readRDS("/Users/debda22/Projects/abis-ferritin-type1-diabetes/results/revision/weighted_cox/fifteen_to_end_of_follow_up_cox_data.RDS")
library(dplyr)
get_iqr <- function(df, label) {
df %>%
summarise(
window = label,
Ferritin = sprintf(
"%.1f (%.1f–%.1f)",
median(Ferritin, na.rm = TRUE),
quantile(Ferritin, 0.25, na.rm = TRUE),
quantile(Ferritin, 0.75, na.rm = TRUE)
),
sTfR = sprintf(
"%.2f (%.2f–%.2f)",
median(TfR, na.rm = TRUE),
quantile(TfR, 0.25, na.rm = TRUE),
quantile(TfR, 0.75, na.rm = TRUE)
),
TfR_F_index = sprintf(
"%.2f (%.2f–%.2f)",
median(sTfR_logFerritin, na.rm = TRUE),
quantile(sTfR_logFerritin, 0.25, na.rm = TRUE),
quantile(sTfR_logFerritin, 0.75, na.rm = TRUE)
),
cases = sum(event == 1, na.rm = TRUE),
n = n()
)
}
window_summary <- bind_rows(
get_iqr(zero2five_df, "0–5"),
get_iqr(five2ten_df, "5–10"),
get_iqr(ten2fifteen_df, "10–15"),
get_iqr(fifteen2followupend_df, "15 - follow-up end")
)
View(window_summary)
